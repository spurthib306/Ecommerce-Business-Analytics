# Python
.venv/
__pycache__/
*.pyc

# Raw Kaggle data: large (geolocation is 60 MB) and licensed CC BY-NC-SA 4.0.
# Re-download with run.sh / run.bat. A 1,000-order sample is committed in Dataset/sample/.
Dataset/raw/*.csv
Dataset/cleaned/*.csv
!Dataset/cleaned/data_quality_profile.csv
!Dataset/cleaned/cleaning_log.csv
Dataset/.kaggle_cache/
Dataset/*.duckdb
Dataset/*.duckdb.wal

# Power BI model extracts (regenerated by step 3)
PowerBI-Dashboard/model/*.csv

# OS files
.DS_Store
Thumbs.db
desktop.ini
